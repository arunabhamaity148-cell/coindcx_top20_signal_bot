# ============================================================================
# COPY THIS FILE TO `.env`  ->  cp .env.example .env
#
# The bot is SIGNAL ONLY. It holds NO exchange trading key and must never be
# given one: app/safety.py aborts the process at boot if BINANCE_/COINDCX_
# trading credentials are detected in the environment.
#
# NEVER commit a filled-in .env. It is already listed in .gitignore.
# ============================================================================

# ---- TELEGRAM DELIVERY (the only outbound credentials this bot needs) ------
# Create a bot with @BotFather, then paste the token here.
TELEGRAM_BOT_TOKEN=
# Your chat, group or channel id (see README §12 "Telegram setup").
TELEGRAM_CHAT_ID=

# SAFETY: keep true until you have watched the formatted messages in the logs.
# While true, every message is rendered and journalled but NOT sent to Telegram.
TELEGRAM_DRY_RUN=true

# ---- RUNTIME --------------------------------------------------------------
SIGNAL_BOT_MODE=signal_only
LOG_LEVEL=INFO
LOG_JSON=true
CONFIG_DIR=config
LOG_DIR=logs
TIMEZONE_UTC=true

# ---- OPTIONAL: FX FOR THE INR QUOTE PATH ----------------------------------
# CoinDCX USDT-margined futures quote in USDT, so no FX rate is required for the
# TOP-20. If you later enable an INR-quoted instrument, supply a VERIFIED
# USDT/INR rate here; otherwise normalization fails closed and NO SIGNAL is
# produced (by design).
USDT_INR_RATE=

# ---- DO NOT ADD ANY OF THE FOLLOWING (the bot will refuse to start) --------
# BINANCE_API_KEY=       BINANCE_API_SECRET=
# COINDCX_API_KEY=       COINDCX_API_SECRET=
# BINANCE_FUTURES_API_KEY=  BINANCE_FUTURES_API_SECRET=
